{{ $image_tag := env "IMAGE_TAG" | default  (exec "../scripts/branded_image_tag.sh" (list) | trim) }}

deploy:
    GITHUB_REPOSITORY: ocelot-social-community/stage.ocelot.social
    IMAGE_TAG: {{ $image_tag }}
    DOMAIN: stage.ocelot.social
    REDIRECT_DOMAINS: []
    NAMESPACE: ocelot-staging
    RELEASE_NAME_OCELOT: ocelot-social
    NEO4J_STORAGE: "5Gi"

ocelot:
    options:
        PRODUCTION_DB_CLEAN_ALLOW: "false"
        PUBLIC_REGISTRATION: "true"
        INVITE_REGISTRATION: "true"
        CATEGORIES_ACTIVE: "true"
        MAX_PINNED_POSTS: "1"
        BADGES_ENABLED: "true"
        NETWORK_NAME: "stage.ocelot.social"
        ASK_FOR_REAL_NAME: "false"
        REQUIRE_LOCATION: "false"
        MAX_GROUP_PINNED_POSTS: "1"
        API_KEYS_ENABLED: "true"
        API_KEYS_MAX_PER_USER: "5"
        SHOW_CONTENT_FILTER_HEADER_MENU: "false"
        SHOW_CONTENT_FILTER_MASONRY_GRID: "true"
        SHOW_GROUP_BUTTON_IN_HEADER: "true"
        # Contact identity. These used to live in branding/constants/emails.js; the runtime branding
        # schema deliberately does not carry them (they are e-mail/link config, not brand design), so
        # they are ENV now. Without them the backend falls back to the ocelot.social defaults.
        SUPPORT_EMAIL: "hello@ocelot.social"
        SUPPORT_LINK: "https://ocelot.social"
        ORGANIZATION_LINK: "https://ocelot.social"
