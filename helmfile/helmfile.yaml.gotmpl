---
environments:
  default:
    values:
      - ./environments/default.yaml.gotmpl
    secrets:
      - ./environments/default.secrets.yaml
  production:
    values:
      - ./environments/production.yaml.gotmpl
    secrets:
      - ./environments/production.secrets.yaml
---
repositories:
  - name: ocelot-social
    url: git+https://github.com/Ocelot-Social-Community/Ocelot-Social@deployment/helm/charts

releases:
  - name: {{ .StateValues.deploy.RELEASE_NAME_OCELOT }}
    namespace: {{ .StateValues.deploy.NAMESPACE }}
    chart: ocelot-social/ocelot-social
    # Order the helm operations so Neo4j is applied first. This does NOT wait for the database
    # to be ready — the backend pod does that itself in its wait-db initContainer — it just
    # stops the backend from being rolled out ahead of a database that does not exist yet.
    needs:
      - ocelot-neo4j
    values:
    - ./values/ocelot.yaml.gotmpl
    secrets:
    - ./secrets/ocelot.yaml.gotmpl

  - name: ocelot-neo4j
    namespace: {{ .StateValues.deploy.NAMESPACE }}
    chart: ocelot-social/ocelot-neo4j
    values:
    - ./values/ocelot.yaml.gotmpl
    secrets:
    - ./secrets/ocelot.yaml.gotmpl
